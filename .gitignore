# Zephyr (west) build output
build/

# IDE / OS clutter
.vscode/
# Eclipse/CubeIDE project files (CubeIDE recreates them while the old project is open)
.project
.cproject
.mxproject
.settings/
*.launch
*.bak
*.tmp
.metadata/
Thumbs.db
.DS_Store

# Reference PDFs (ST manuals, MISRA) are local only; download them, don't commit
docs/*.pdf

# MISRA C standard is licensed to one person; never commit it or text extracted from it
docs/MISRA-*.pdf
docs/misra-*-rule-texts.txt

# cppcheck intermediate files
*.dump
*.ctu-info

# VS Code multi-root workspace: paths depend on this PC's west workspace layout
*.code-workspace

# Claude Code local settings
.claude/

# Packet captures hold MAC addresses, hostnames and LAN traffic; local only
*.pcap
*.pcapng
docs/network-packets/
