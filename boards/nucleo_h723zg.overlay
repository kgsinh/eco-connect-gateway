/*
 * PB14 (LD3, red) is driven by CMSIS code in led_cmsis.c. The board DTS
 * routes it to TIM12_CH1 for a PWM LED, and the Zephyr PWM driver would
 * claim the pin at boot, so take TIM12/PWM12 and the pwm-leds node away.
 */
&timers12 {
	status = "disabled";
};

&pwm12 {
	status = "disabled";
};

/ {
	pwmleds {
		status = "disabled";
	};
};

/*
 * BME280 breakout on the Arduino I2C pins (I2C1: SCL PB8 / D15, SDA PB9 / D14,
 * 400 kHz from the board DTS). 4-pin breakouts tie SDO on the board; 0x76 is
 * SDO to GND, 0x77 is SDO to VDDIO (BME280 data sheet 6.2).
 */
&i2c1 {
	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};
};
