# STM32Cube HAL/LL modules are promptless Kconfig symbols (USE_STM32_HAL_*,
# USE_STM32_LL_*), so prj.conf cannot set them; select them from here.
# Add one entry per HAL/LL module the app calls directly.

config APP_STM32_HAL_GPIO
	bool "Application uses STM32Cube HAL GPIO"
	default y
	select USE_STM32_HAL_GPIO

# Static IPv4 address, added alongside DHCP so the board is reachable when
# cabled straight to a PC (no DHCP server). Empty string disables it.

config APP_NET_STATIC_IPV4_ADDR
	string "Static IPv4 address (empty = DHCP only)"
	default "192.168.50.2"

config APP_NET_STATIC_IPV4_NETMASK
	string "Netmask for the static IPv4 address"
	default "255.255.255.0"

source "Kconfig.zephyr"
